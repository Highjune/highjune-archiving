// Docker 컨테이너 로그 → Loki. 컨테이너 이름을 app 라벨로 바꿔 Grafana에서 앱별로 본다.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["container"]
    regex         = "snt-app"
    replacement   = "snt-app"   // 컨테이너명 그대로 (2026-10-29 tennis→snt-app)
    target_label  = "app"
  }
  rule {
    source_labels = ["container"]
    regex         = "couponnote-api"
    replacement   = "couponnote"
    target_label  = "app"
  }
  rule {
    source_labels = ["container"]
    regex         = "home-mysql"
    replacement   = "mysql"
    target_label  = "app"
  }
  rule {
    source_labels = ["container"]
    regex         = "jenkins-server"
    replacement   = "jenkins"
    target_label  = "app"
  }
  rule {
    source_labels = ["container"]
    regex         = "highnance-alert"
    replacement   = "highnance"
    target_label  = "app"
  }
  rule {
    source_labels = ["app"]
    regex         = ""
    replacement   = "infra"
    target_label  = "app"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.app_logs.receiver]
}

// 로그 줄에서 level 만 라벨로 뽑는다. 못 뽑는 줄(MySQL, Jenkins 등)은 level 라벨 없이 통과.
// Spring Boot 버전에 따라 ECS JSON 키 모양이 다르다:
//   - Boot 4 (쿠폰노트): 중첩 {"log":{"level":"INFO"}}  -> JMESPath log.level
//   - Boot 3.4 (테니스): 평탄 {"log.level":"INFO"}       -> JMESPath "log.level" (따옴표 식별자)
//   JMESPath `||` 로 둘 중 먼저 있는 값을 쓴다. 둘 다 없으면 null -> extracted 에 안 들어감.
// 하이낸스 알림(파이썬 logging): "2026-10-29 21:20:12,670 INFO app.poller: ..." -> 정규식으로 level.
loki.process "app_logs" {
  stage.json {
    expressions = {
      level = "log.level || \"log.level\"",
    }
  }
  stage.regex {
    expression = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d+ (?P<level>[A-Z]+) "
  }
  stage.labels {
    values = {
      level = "",
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
